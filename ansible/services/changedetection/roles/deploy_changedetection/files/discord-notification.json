{%- set p = diff(lines=10)|replace("@changed_PLACEMARKER_OPEN","- ")|replace("@changed_PLACEMARKER_CLOSED","")|replace("@changed_into_PLACEMARKER_OPEN","+ ")|replace("@changed_into_PLACEMARKER_CLOSED","")|replace("@added_PLACEMARKER_OPEN","+ ")|replace("@added_PLACEMARKER_CLOSED","")|replace("@removed_PLACEMARKER_OPEN","- ")|replace("@removed_PLACEMARKER_CLOSED","") -%}{"username":"Change Detector","embeds":[{"title":"Change detected","description":{{ ("**" ~ watch_title ~ "** has changed.")|tojson }},"color":16744272,"fields":[{"name":"Diff","value":{{ ("```diff\n" ~ p ~ "\n```")|tojson }},"inline":false},{"name":"URL","value":"{{ watch_url }}","inline":true}],"footer":{"text":"changedetection.io"}}]}