{%- set p = diff(lines=10)|replace("@changed_PLACEMARKER_OPEN","- ")|replace("@changed_PLACEMARKER_CLOSED","")|replace("@changed_into_PLACEMARKER_OPEN","+ ")|replace("@changed_into_PLACEMARKER_CLOSED","")|replace("@added_PLACEMARKER_OPEN","+ ")|replace("@added_PLACEMARKER_CLOSED","")|replace("@removed_PLACEMARKER_OPEN","- ")|replace("@removed_PLACEMARKER_CLOSED","") -%}{"username":"Change Detector","avatar_url":"https://cdn.dev.playcademy.net/public/icons/logo_icon_v2.png","embeds":[{"title":"Change detected","url":"{{ watch_url }}","description":{{ ("**" ~ watch_title ~ "** has changed.")|tojson }},"color":16744272,"fields":[{"name":"Diff","value":{{ ("```diff\n" ~ p ~ "\n```")|tojson }},"inline":false}],"footer":{"text":"changedetection.io"}}]}